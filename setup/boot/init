#!/bin/sh

dmesg -n 1
clear

mount -t proc none /proc
mount -t sysfs none /sys
mount -t devtmpfs none /dev

mkdir -p /home/qss
echo "qb:x:1000:1000:Mahdi,,,:/home/qb:/bin/sh" >> /etc/passwd
echo "qb ALL=(ALL:ALL) ALL" >> /etc/sudoers
echo "qb:x:1000:" >> /etc/group
echo "qb" > /etc/hostname
echo "qb:qb" | chpasswd

exec sbin/init